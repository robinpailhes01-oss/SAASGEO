# =====================================================================
# ANKORA — Variables d'environnement (template)
#
# Ce fichier est commite. Il documente toutes les variables attendues
# avec des valeurs vides ou exemples non sensibles.
#
# Pour le developpement local : copie ce fichier vers .env.local
# et remplis les valeurs reelles. Ce fichier .env.local n'est PAS
# commite (cf. .gitignore).
#
# En production : configure ces variables dans Vercel
# (Settings > Environment Variables).
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE (Bloc 1 — requis maintenant)
# Cree ton projet sur https://supabase.com/dashboard
# Region recommandee : EU Frankfurt (eu-central-1) pour RGPD client FR
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# AUTH ADMIN (Bloc 1 — V0 single-user)
# Credentials simples pour proteger l'app en V0 (1 seul user = toi).
# En V2 on remplace par Supabase Auth complet.
# ---------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------
# APIS LLM (Bloc 3 — fournies au jour 5-7)
# Cap budget a configurer sur chaque plateforme avant ajout.
# ---------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys (cap 30 EUR/mois)
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/ (cap 30 EUR/mois)
ANTHROPIC_API_KEY=

# Perplexity — https://www.perplexity.ai/settings/api (cap 20 EUR/mois)
PERPLEXITY_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey (free tier genereux)
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# SCRAPING (Bloc 2 — Jina suffit en MVP, Browserless en fallback)
# ---------------------------------------------------------------------
# Jina Reader — endpoint public r.jina.ai/{url} (cle optionnelle pour rate limit etendu)
JINA_API_KEY=

# Browserless — https://www.browserless.io/ (free tier 1000 units)
BROWSERLESS_TOKEN=

# ---------------------------------------------------------------------
# ORCHESTRATION (Bloc 4 — fournies au jour 8)
# ---------------------------------------------------------------------
# Inngest — https://www.inngest.com/ (free tier 50k executions/mois)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------
# EMAILS TRANSACTIONNELS (Bloc 4 — alertes budget)
# ---------------------------------------------------------------------
# Resend — https://resend.com/ (free tier 3000 emails/mois)
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@ankora.ai

# ---------------------------------------------------------------------
# OPTIONNELLES PHASE 1 (peuvent attendre Phase 2)
# ---------------------------------------------------------------------
# Google PageSpeed Insights — Core Web Vitals (catégorie audit 1)
PAGESPEED_API_KEY=

# Google Places — reviews Google Business (catégorie audit 5 lite)
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------
# CAPS BUDGET (controle interne anti-derapage)
# ---------------------------------------------------------------------
# Budget total mensuel API en euros (cap dur en code)
MONTHLY_API_BUDGET_EUR=90

# Seuil d'alerte email (envoi un mail quand on franchit ce montant)
BUDGET_WARNING_THRESHOLD_EUR=70
BUDGET_CRITICAL_THRESHOLD_EUR=85

# Cap dur sur le nombre d'audits par mois
MONTHLY_AUDIT_CAP=75

# ---------------------------------------------------------------------
# CONFIG GENERALE
# ---------------------------------------------------------------------
# URL publique de l'app (utilisee dans les emails, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement Node
NODE_ENV=development
